{
  "system_name": "教育培训管理系统",
  "architecture_pattern": "微服务架构",
  "deployment": "Docker + Kubernetes",
  "layers": {
    "presentation_layer": {
      "description": "展示层 - 小程序端",
      "components": [
        {
          "name": "学员小程序",
          "framework": "微信小程序原生 / UniApp",
          "pages": [
            "首页",
            "课表",
            "签到",
            "请假",
            "我的"
          ],
          "features": [
            "扫码签到",
            "课表查看",
            "课时查询",
            "作业提交"
          ]
        },
        {
          "name": "家长小程序",
          "framework": "微信小程序原生 / UniApp",
          "pages": [
            "首页",
            "课表",
            "请假",
            "消费记录",
            "我的"
          ],
          "features": [
            "多孩切换",
            "消息通知",
            "请假申请",
            "成长报告"
          ]
        },
        {
          "name": "教师小程序",
          "framework": "微信小程序原生 / UniApp",
          "pages": [
            "首页",
            "课表",
            "课堂点名",
            "反馈提交",
            "我的"
          ],
          "features": [
            "批量点名",
            "二维码生成",
            "课堂反馈",
            "作业批改"
          ]
        },
        {
          "name": "管理后台",
          "framework": "Vue3 + Element Plus / React + Ant Design",
          "pages": [
            "工作台",
            "教务管理",
            "学员管理",
            "财务管理",
            "营销中心"
          ],
          "features": [
            "数据可视化",
            "拖拽排课",
            "报表导出",
            "权限管理"
          ]
        }
      ]
    },
    "gateway_layer": {
      "description": "网关层",
      "components": [
        {
          "name": "API Gateway",
          "technology": "Spring Cloud Gateway / Nginx",
          "responsibilities": [
            "统一入口",
            "请求路由",
            "负载均衡",
            "限流熔断",
            "日志记录"
          ]
        },
        {
          "name": "Authentication Service",
          "technology": "JWT + Redis",
          "responsibilities": [
            "用户认证",
            "Token签发/刷新",
            "权限校验",
            "单点登录"
          ]
        }
      ]
    },
    "service_layer": {
      "description": "业务服务层 - 微服务",
      "services": [
        {
          "name": "user-service",
          "description": "用户服务",
          "responsibilities": [
            "学员管理",
            "家长管理",
            "教师管理",
            "员工管理"
          ],
          "database": "MySQL",
          "cache": "Redis",
          "port": 8001
        },
        {
          "name": "course-service",
          "description": "课程服务",
          "responsibilities": [
            "课程管理",
            "班级管理",
            "教室管理"
          ],
          "database": "MySQL",
          "cache": "Redis",
          "port": 8002
        },
        {
          "name": "schedule-service",
          "description": "排课服务",
          "responsibilities": [
            "排课管理",
            "冲突检测",
            "调课处理"
          ],
          "database": "MySQL",
          "cache": "Redis",
          "port": 8003,
          "key_features": [
            "分布式锁防止并发冲突",
            "排课规则引擎"
          ]
        },
        {
          "name": "attendance-service",
          "description": "考勤服务",
          "responsibilities": [
            "签到处理",
            "请假管理",
            "补课预约",
            "考勤统计"
          ],
          "database": "MySQL",
          "cache": "Redis",
          "port": 8004,
          "key_features": [
            "二维码生成与校验",
            "GPS定位校验"
          ]
        },
        {
          "name": "consume-service",
          "description": "消课服务",
          "responsibilities": [
            "课时核销",
            "课时流水",
            "课时预警"
          ],
          "database": "MySQL",
          "cache": "Redis",
          "port": 8005,
          "key_features": [
            "事务保证数据一致性",
            "异步消课处理"
          ]
        },
        {
          "name": "order-service",
          "description": "订单服务",
          "responsibilities": [
            "报名订单",
            "支付处理",
            "退款管理",
            "优惠计算"
          ],
          "database": "MySQL",
          "cache": "Redis",
          "port": 8006,
          "key_features": [
            "分布式事务",
            "支付回调幂等处理"
          ]
        },
        {
          "name": "feedback-service",
          "description": "反馈服务",
          "responsibilities": [
            "课堂反馈",
            "学员评价",
            "成长报告"
          ],
          "database": "MySQL",
          "port": 8007
        },
        {
          "name": "message-service",
          "description": "消息服务",
          "responsibilities": [
            "微信推送",
            "短信通知",
            "站内消息",
            "消息模板管理"
          ],
          "database": "MongoDB",
          "mq": "RabbitMQ",
          "port": 8008,
          "key_features": [
            "异步消息发送",
            "消息重试机制",
            "消息追踪"
          ]
        },
        {
          "name": "statistics-service",
          "description": "统计服务",
          "responsibilities": [
            "数据聚合",
            "报表生成",
            "数据可视化",
            "导出功能"
          ],
          "database": "MySQL + ClickHouse",
          "port": 8009,
          "key_features": [
            "定时ETL任务",
            "大数据量报表优化"
          ]
        },
        {
          "name": "marketing-service",
          "description": "营销服务",
          "responsibilities": [
            "优惠活动",
            "积分系统",
            "裂变工具",
            "优惠券"
          ],
          "database": "MySQL",
          "cache": "Redis",
          "port": 8010
        }
      ]
    },
    "data_layer": {
      "description": "数据存储层",
      "components": [
        {
          "name": "MySQL Cluster",
          "purpose": "业务主数据存储",
          "tables": [
            "students",
            "teachers",
            "courses",
            "classes",
            "schedules",
            "attendances",
            "orders"
          ],
          "architecture": "主从复制 + 读写分离",
          "backup": "每日全量备份 + binlog增量"
        },
        {
          "name": "Redis Cluster",
          "purpose": "缓存与高速数据",
          "data_types": [
            "Session/Token存储",
            "签到二维码缓存(5分钟TTL)",
            "课时余额缓存",
            "排课分布式锁",
            "热点数据缓存"
          ],
          "cluster_mode": "Redis Cluster 6主6从"
        },
        {
          "name": "MongoDB",
          "purpose": "日志与消息存储",
          "collections": [
            "operation_logs",
            "message_logs",
            "notification_records"
          ],
          "ttl": "90天自动过期"
        },
        {
          "name": "OSS/COS",
          "purpose": "文件存储",
          "file_types": [
            "头像",
            "课堂照片",
            "作业附件",
            "导出报表"
          ],
          "cdn": "阿里云CDN加速"
        }
      ]
    }
  },
  "infrastructure": {
    "container": "Docker",
    "orchestration": "Kubernetes",
    "ci_cd": "Jenkins / GitLab CI",
    "monitoring": "Prometheus + Grafana",
    "logging": "ELK Stack (Elasticsearch + Logstash + Kibana)",
    "apm": "SkyWalking",
    "mq": "RabbitMQ Cluster"
  },
  "security": {
    "authentication": "JWT Token + Refresh Token",
    "authorization": "RBAC权限模型",
    "data_encryption": "敏感字段AES加密",
    "api_security": "HTTPS + 接口签名 + 防重放攻击",
    "sql_injection": "MyBatis参数化查询",
    "xss_protection": "输入过滤 + 输出转义"
  },
  "performance": {
    "caching_strategy": [
      "Redis缓存热点数据",
      "本地Caffeine缓存配置数据",
      "数据库查询结果缓存"
    ],
    "database_optimization": [
      "读写分离",
      "分库分表(按机构ID分片)",
      "索引优化",
      "慢查询监控"
    ],
    "async_processing": [
      "消息推送异步化",
      "消课异步处理",
      "报表生成异步化",
      "数据同步异步化"
    ]
  }
}