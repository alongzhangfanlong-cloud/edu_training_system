{
  "project_name": "教育培训管理系统 - 小程序端",
  "version": "1.0.0",
  "description": "面向K12、艺术培训、语言培训、职业技能培训等机构的移动端管理工具",
  "roles": [
    {
      "role_id": "boss",
      "role_name": "老板端",
      "description": "机构老板/超级管理员",
      "core_features": ["全平台数据看板", "多校区管理", "用户与权限管理", "财务管理", "教务总览", "系统配置"]
    },
    {
      "role_id": "principal",
      "role_name": "校长端",
      "description": "单校区校长",
      "core_features": ["校区数据看板", "教师课时统计", "学员课时统计", "校区排课管理"]
    },
    {
      "role_id": "teacher",
      "role_name": "教师端",
      "description": "授课教师",
      "core_features": ["今日授课查看", "学员点名签到", "布置作业", "学员成长评价", "课堂反馈提交"]
    },
    {
      "role_id": "parent",
      "role_name": "家长端",
      "description": "家长监督与沟通",
      "core_features": ["查看孩子课表", "请假申请", "课时查询", "积分查看", "成长档案查看"]
    },
    {
      "role_id": "student",
      "role_name": "学员端",
      "description": "学生本人使用",
      "core_features": ["我的课表", "签到打卡", "课时余额查询", "个人中心"]
    }
  ],
  "products": {
    "admin_app": {"name": "PC管理后台", "port": 3000, "tech": "Vue3 + Element Plus + ECharts"},
    "h5_miniapp": {"name": "H5小程序端", "port": 4000, "tech": "Vue3 + Vant UI"},
    "student_miniapp": {"name": "学员小程序(原生)", "status": "规划中"},
    "teacher_miniapp": {"name": "教师小程序(原生)", "status": "规划中"}
  },
  "tech_stack": {
    "frontend": "Vue3 + Element Plus(PC端) / Vant UI(H5端)",
    "backend": "Spring Boot 3.2.0 单体应用",
    "database": {
      "primary": "MySQL 8.0",
      "cache": "Redis 6.x",
      "document": "MongoDB",
      "file_storage": "阿里云OSS / 腾讯云COS"
    },
    "message_queue": "RabbitMQ / RocketMQ",
    "api_gateway": "Spring Cloud Gateway / Nginx"
  }
}