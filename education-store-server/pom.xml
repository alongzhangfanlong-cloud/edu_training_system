<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.education.store</groupId>
    <artifactId>edu-server</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Edu Server</name>
    <description>教育店铺管理系统 - 后端服务</description>

    <modules>
        <module>edu-common</module>
        <module>edu-security</module>
        <module>edu-modules/edu-module-system</module>
        <module>edu-modules/edu-module-course</module>
        <module>edu-modules/edu-module-class</module>
        <module>edu-modules/edu-module-student</module>
        <module>edu-modules/edu-module-prospect</module>
        <module>edu-modules/edu-module-schedule</module>
        <module>edu-modules/edu-module-enrollment</module>
        <module>edu-modules/edu-module-payroll</module>
        <module>edu-modules/edu-module-tuition</module>
        <module>edu-modules/edu-module-attendance</module>
        <module>edu-server-app</module>
    </modules>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.0</version>
        <relativePath/>
    </parent>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <mybatis-plus.version>3.5.5</mybatis-plus.version>
        <hutool.version>5.8.24</hutool.version>
        <knife4j.version>4.4.0</knife4j.version>
        <jjwt.version>0.12.3</jjwt.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 内部模块 -->
            <dependency>
                <groupId>com.education.store</groupId>
                <artifactId>edu-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.education.store</groupId>
                <artifactId>edu-security</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.education.store</groupId>
                <artifactId>edu-module-system</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.education.store</groupId>
                <artifactId>edu-module-course</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.education.store</groupId>
                <artifactId>edu-module-class</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.education.store</groupId>
                <artifactId>edu-module-student</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.education.store</groupId>
                <artifactId>edu-module-prospect</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.education.store</groupId>
                <artifactId>edu-module-schedule</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.education.store</groupId>
                <artifactId>edu-module-enrollment</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.education.store</groupId>
                <artifactId>edu-module-payroll</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.education.store</groupId>
                <artifactId>edu-module-tuition</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.education.store</groupId>
                <artifactId>edu-module-attendance</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- MyBatis-Plus -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>

            <!-- Hutool 工具集 -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool.version}</version>
            </dependency>

            <!-- Knife4j API文档 -->
            <dependency>
                <groupId>com.github.xiaoymin</groupId>
                <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
                <version>${knife4j.version}</version>
            </dependency>

            <!-- JWT -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
                <scope>runtime</scope>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
                <scope>runtime</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
